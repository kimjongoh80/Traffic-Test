<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{.Title}} - {{.In.ID}}</title>
<style>
  @page { size: A4; margin: 14mm 12mm; }
  * { box-sizing: border-box; }
  body { margin: 0; background: #eef1f5; color: #18202b; font: 13px/1.5 "Segoe UI", "Malgun Gothic", "Apple SD Gothic Neo", system-ui, sans-serif; }
  .page { max-width: 900px; margin: 24px auto; background: #fff; padding: 36px 40px; border-radius: 8px; box-shadow: 0 2px 10px rgba(0,0,0,.08); }
  .toolbar { max-width: 900px; margin: 16px auto -8px; display: flex; justify-content: flex-end; gap: 8px; padding: 0 4px; }
  .toolbar button { border: 1px solid #2563eb; background: #2563eb; color: #fff; border-radius: 6px; padding: 7px 16px; font: inherit; cursor: pointer; font-weight: 600; }
  .toolbar button.sec { background: #fff; color: #2563eb; }
  header { display: flex; justify-content: space-between; align-items: flex-start; border-bottom: 2px solid #18202b; padding-bottom: 14px; margin-bottom: 20px; gap: 16px; }
  h1 { font-size: 22px; margin: 0 0 4px; }
  .meta { color: #667085; font-size: 12px; }
  .verdict { font-size: 22px; font-weight: 800; padding: 8px 22px; border-radius: 8px; letter-spacing: .05em; white-space: nowrap; border: 2px solid; }
  .pass { color: #15803d; border-color: #15803d; background: #f0fdf4; }
  .fail { color: #b91c1c; border-color: #b91c1c; background: #fef2f2; }
  .none { color: #667085; border-color: #d0d5dd; background: #f8fafc; font-size: 14px; }
  h2 { font-size: 15px; margin: 26px 0 10px; padding-left: 9px; border-left: 4px solid #2563eb; }
  table { width: 100%; border-collapse: collapse; font-variant-numeric: tabular-nums; }
  th, td { padding: 6px 9px; border-bottom: 1px solid #e4e7ec; text-align: right; white-space: nowrap; }
  th { background: #f5f7fa; color: #475467; font-weight: 600; font-size: 12px; }
  th:first-child, td:first-child { text-align: left; }
  table.info td:first-child { color: #475467; width: 34%; background: #f9fafb; }
  table.info td { text-align: left; white-space: normal; }
  .grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; }
  .grid div { border: 1px solid #e4e7ec; border-radius: 6px; padding: 8px 10px; }
  .grid span { display: block; font-size: 11px; color: #667085; }
  .grid b { font-size: 14px; font-variant-numeric: tabular-nums; }
  .tag { display: inline-block; font-size: 11px; font-weight: 700; padding: 1px 8px; border-radius: 4px; }
  .tag.pass, .tag.fail { border: 0; }
  tr.sum td { font-weight: 700; background: #f9fafb; }
  .chart { width: 100%; height: auto; display: block; margin-bottom: 6px; border: 1px solid #e4e7ec; border-radius: 6px; }
  .chart .grid { stroke: #e8ebf0; stroke-width: 1; }
  .chart .ax { fill: #667085; font-size: 11px; }
  .chart .lg { fill: #475467; font-size: 11.5px; }
  .chart .th { stroke: #dc2626; stroke-width: 1.3; stroke-dasharray: 6 4; }
  .chart .thl { fill: #dc2626; font-size: 11px; }
  .charts { display: grid; grid-template-columns: 1fr; gap: 10px; }
  .note { color: #667085; font-size: 11.5px; margin-top: 6px; }
  .small-table td, .small-table th { padding: 4px 7px; font-size: 11.5px; }
  footer { margin-top: 28px; padding-top: 10px; border-top: 1px solid #e4e7ec; color: #98a2b3; font-size: 11px; display: flex; justify-content: space-between; }
  .warn { background: #fffbeb; border: 1px solid #fcd34d; color: #92400e; padding: 8px 12px; border-radius: 6px; margin-bottom: 14px; }
  @media (max-width: 700px) { .page { padding: 20px 16px; margin: 12px 0; border-radius: 0; } .grid { grid-template-columns: repeat(2, 1fr); } header { flex-direction: column; } .scroll { overflow-x: auto; } }
  @media print {
    body { background: #fff; font-size: 11.5px; }
    .page { margin: 0; padding: 0; box-shadow: none; max-width: none; border-radius: 0; }
    .toolbar { display: none; }
    h2 { break-after: avoid; }
    .chart, table.info, .grid, tr { break-inside: avoid; }
    .charts { grid-template-columns: 1fr; gap: 6px; }
    h2.charts-h { break-before: page; }
    * { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
  }
</style>
</head>
<body>
<div class="toolbar">
  <button class="sec" onclick="history.length > 1 ? history.back() : window.close()">닫기</button>
  <button onclick="window.print()">PDF로 저장 / 인쇄</button>
</div>
<div class="page">
  <header>
    <div>
      <h1>{{.Title}}</h1>
      <div class="meta">시험 일시 {{.Started}} · 보고서 번호 {{.In.ID}}</div>
      <div class="meta">{{.Sender}} → {{.Receiver}} · {{upper .R.Params.Protocol}} · 스트림 {{.R.Params.Streams}}</div>
    </div>
    {{if not .In.Verdict.Evaluated}}<div class="verdict none">판정 기준 없음</div>
    {{else if .In.Verdict.Pass}}<div class="verdict pass">PASS</div>
    {{else}}<div class="verdict fail">FAIL</div>{{end}}
  </header>

  {{if .In.Stopped}}<div class="warn">이 테스트는 설정 시간 전에 중지되어 부분 결과만 포함합니다.</div>{{end}}

  <h2>시험 정보</h2>
  <table class="info">
    {{range .Info}}<tr><td>{{.K}}</td><td>{{.V}}</td></tr>{{end}}
  </table>

  <h2>결과 요약</h2>
  <div class="grid">
    {{range .Summary}}<div><span>{{.K}}</span><b>{{.V}}</b></div>{{end}}
  </div>
  {{if not .UDP}}<p class="note">TCP는 재전송으로 손실을 보정하므로 패킷 손실 대신 RTT 프로브 손실률을 표시합니다. RTT는 트래픽이 흐르는 동안(부하 상태) 측정한 값입니다.</p>{{end}}

  {{if .In.Verdict.Evaluated}}
  <h2>판정 결과</h2>
  <table>
    <tr><th>항목</th><th>기준</th><th>측정값</th><th>결과</th></tr>
    {{range .In.Verdict.Checks}}<tr><td>{{check .Name}}</td><td>{{.Limit}}</td><td>{{.Measured}}</td><td>{{if .Pass}}<span class="tag pass">PASS</span>{{else}}<span class="tag fail">FAIL</span>{{end}}</td></tr>{{end}}
  </table>
  {{end}}

  <h2 class="charts-h">그래프</h2>
  <div class="charts">
    {{range .Charts}}{{.}}{{end}}
  </div>

  <h2>스트림별 결과</h2>
  <div class="scroll"><table>
    {{if .UDP}}
    <tr><th>스트림</th><th>수신량</th><th>평균 대역폭</th><th>수신 패킷</th><th>손실</th><th>손실률</th><th>지터</th><th>순서 뒤바뀜</th></tr>
    {{range .Streams}}<tr{{if .Sum}} class="sum"{{end}}><td>{{.Name}}</td><td>{{bytes .Bytes}}</td><td>{{bits .Bps}}</td><td>{{int .Packets}}</td><td>{{int .Lost}}</td><td>{{pct .LossPct}}</td><td>{{ms3 .Jitter}}</td><td>{{int .OOO}}</td></tr>{{end}}
    {{else}}
    <tr><th>스트림</th><th>수신량</th><th>평균 대역폭</th></tr>
    {{range .Streams}}<tr{{if .Sum}} class="sum"{{end}}><td>{{.Name}}</td><td>{{bytes .Bytes}}</td><td>{{bits .Bps}}</td></tr>{{end}}
    {{end}}
  </table></div>

  <h2>구간별 결과</h2>
  <div class="scroll"><table class="small-table">
    {{if .UDP}}
    <tr><th>구간</th><th>전송량</th><th>대역폭</th><th>지터</th><th>손실/전체</th><th>손실률</th><th>RTT 평균</th><th>RTT 최대</th></tr>
    {{range .Intervals}}<tr><td>{{f1 .Start}}–{{f1 .End}}s</td><td>{{bytes .Sum.Bytes}}</td><td>{{bits .Sum.BitsPerSec}}</td><td>{{ms3 .Sum.JitterMs}}</td><td>{{int .Sum.Lost}}/{{lost .Sum | int}}</td><td>{{pct .Sum.LossPct}}</td><td>{{if and .Latency (gt .Latency.Received 0)}}{{ms .Latency.AvgMs}}{{else}}-{{end}}</td><td>{{if and .Latency (gt .Latency.Received 0)}}{{ms .Latency.MaxMs}}{{else}}-{{end}}</td></tr>{{end}}
    {{else}}
    <tr><th>구간</th><th>전송량</th><th>대역폭</th><th>RTT 평균</th><th>RTT 최대</th><th>RTT 지터</th></tr>
    {{range .Intervals}}<tr><td>{{f1 .Start}}–{{f1 .End}}s</td><td>{{bytes .Sum.Bytes}}</td><td>{{bits .Sum.BitsPerSec}}</td><td>{{if and .Latency (gt .Latency.Received 0)}}{{ms .Latency.AvgMs}}{{else}}-{{end}}</td><td>{{if and .Latency (gt .Latency.Received 0)}}{{ms .Latency.MaxMs}}{{else}}-{{end}}</td><td>{{if and .Latency (gt .Latency.Received 1)}}{{ms .Latency.JitterMs}}{{else}}-{{end}}</td></tr>{{end}}
    {{end}}
  </table></div>

  <footer>
    <span>Traffic-Test {{.In.Version}}</span>
    <span>보고서 생성 {{.Generated}}</span>
  </footer>
</div>
</body>
</html>
